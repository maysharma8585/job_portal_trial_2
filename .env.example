# MySQL ODBC 8.0 Unicode Driver; database must already exist.
DATABASE_DRIVER=mysql
DATABASE_CONNECTION=DRIVER={MySQL ODBC 8.0 Unicode Driver};SERVER=127.0.0.1;PORT=3306;DATABASE=launchboard;USER=launchboard;PASSWORD=change-me;OPTION=3;
# For Access instead: DATABASE_DRIVER=access and DATABASE_CONNECTION=Driver={Microsoft Access Driver (*.mdb, *.accdb)};Dbq=C:\\path\\launchboard.accdb;
PORT=8080
